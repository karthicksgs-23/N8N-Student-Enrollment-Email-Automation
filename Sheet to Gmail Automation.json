        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const row = item.json;\n\n  // Extract student details with fallbacks\n  const name = row['Name'] || 'Student';\n  const email = row['Email'] || '';\n  const course = row['Course'] || 'N/A';\n  const status = row['Fee_Paid_status'] || 'Pending';\n\n  // Build the message body matching your exact structure\n  const body = `Hi,\n\nHere is the latest data from the sheet:\n  Name: ${name}\n  Course: ${course}\n  Fee_Paid_Status: ${status}\n\nRegards,\nYour Automation Bot`;\n\n  results.push({\n    json: {\n      toEmail: email,\n      name: name,\n      course: course,\n      Fee_Paid_status: status,\n      subject: 'Data Summary from Google Sheet',\n      messageBody: body\n    }\n  });\n}\n\nreturn results;"
      },
